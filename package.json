{
  "name": "viotechpm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "server": "npm run dev:server",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w server",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:local": "node scripts/local-db.mjs setup",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
