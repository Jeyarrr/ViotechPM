generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(50)
  name        String   @unique @db.VarChar(80)
  description String   @db.VarChar(300)
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("roles")
}

model Department {
  transactions ProjectTransaction[]
  projects     Project[]
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique @db.VarChar(100)
  users        User[]
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("departments")
}

model User {
  recordedExpenses        Expense[]            @relation("ExpenseRecorder")
  requestedTransactions   ProjectTransaction[] @relation("TransactionRequester")
  assignedApprovalSteps   ApprovalStep[]       @relation("StepApprover")
  approvalDecisions       ApprovalDecision[]   @relation("DecisionApprover")
  primaryApprovalPolicies ApprovalPolicy[]     @relation("PolicyPrimary")
  finalApprovalPolicies   ApprovalPolicy[]     @relation("PolicyFinal")
  editedApprovalPolicies  ApprovalPolicy[]     @relation("PolicyEditor")
  id                      String               @id @default(uuid()) @db.Uuid
  name                    String               @db.VarChar(150)
  email                   String               @unique @db.VarChar(254)
  passwordHash            String               @map("password_hash")
  roleId                  String               @map("role_id") @db.Uuid
  role                    Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status                  AccountStatus        @default(ACTIVE)
  departmentId            String?              @map("department_id") @db.Uuid
  department              Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  profileImage            String?              @map("profile_image")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt             DateTime?            @map("last_login_at") @db.Timestamptz(3)
  auditLogs               AuditLog[]
  createdClients          Client[]
  managedProjects         Project[]            @relation("ProjectManager")
  createdProjects         Project[]            @relation("ProjectCreator")
  memberships             ProjectMember[]      @relation("MemberUser")
  assignedMembers         ProjectMember[]      @relation("MemberAssigner")
  assignedTasks           Task[]               @relation("TaskAssignee")
  createdTasks            Task[]               @relation("TaskCreator")
  responsibleMilestones   Milestone[]          @relation("MilestoneResponsible")
  createdMilestones       Milestone[]          @relation("MilestoneCreator")

  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@map("users")
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

model Client {
  projects      Project[]
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(40)
  name          String        @db.VarChar(180)
  type          ClientType    @default(BUSINESS)
  contactPerson String?       @map("contact_person") @db.VarChar(150)
  email         String?       @db.VarChar(254)
  phone         String?       @db.VarChar(50)
  address       String?       @db.VarChar(500)
  industry      String?       @db.VarChar(120)
  status        AccountStatus @default(ACTIVE)
  notes         String?       @db.VarChar(4000)
  createdById   String        @map("created_by_id") @db.Uuid
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(3)

  @@index([archivedAt, status, name])
  @@index([createdById])
  @@map("clients")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectCategory {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(120)
  active   Boolean   @default(true)
  projects Project[]

  @@map("project_categories")
}

model Project {
  expenses             Expense[]
  transactions         ProjectTransaction[]
  approvalPolicy       ApprovalPolicy?
  milestones           Milestone[]
  members              ProjectMember[]
  tasks                Task[]
  id                   String               @id @default(uuid()) @db.Uuid
  code                 String               @unique @db.VarChar(40)
  name                 String               @db.VarChar(180)
  description          String?              @db.VarChar(4000)
  clientId             String               @map("client_id") @db.Uuid
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  categoryId           String               @map("category_id") @db.Uuid
  category             ProjectCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  managerId            String               @map("manager_id") @db.Uuid
  manager              User                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  departmentId         String?              @map("department_id") @db.Uuid
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  startDate            DateTime             @map("start_date") @db.Date
  targetDate           DateTime             @map("target_date") @db.Date
  actualCompletionDate DateTime?            @map("actual_completion_date") @db.Date
  budget               Decimal?             @db.Decimal(16, 2)
  priority             Priority             @default(MEDIUM)
  status               ProjectStatus        @default(PLANNING)
  createdById          String               @map("created_by_id") @db.Uuid
  createdBy            User                 @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(3)

  @@index([archivedAt, status, targetDate])
  @@index([managerId])
  @@index([clientId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([createdById])
  @@map("projects")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

model ProjectMember {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict)
  role         String   @default("Member") @db.VarChar(80)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedById String   @map("assigned_by_id") @db.Uuid
  assignedBy   User     @relation("MemberAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([assignedById])
  @@map("project_members")
}

model Task {
  milestoneId String?    @map("milestone_id") @db.Uuid
  milestone   Milestone? @relation(fields: [milestoneId, projectId], references: [id, projectId], onDelete: Restrict)
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(40)
  projectId   String     @map("project_id") @db.Uuid
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title       String     @db.VarChar(180)
  description String?    @db.VarChar(4000)
  assigneeId  String?    @map("assignee_id") @db.Uuid
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  startDate   DateTime   @map("start_date") @db.Date
  dueDate     DateTime   @map("due_date") @db.Date
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdById String     @map("created_by_id") @db.Uuid
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(3)

  @@index([projectId, archivedAt, status])
  @@index([assigneeId, dueDate])
  @@index([createdById])
  @@index([milestoneId, archivedAt, status])
  @@map("tasks")
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  DELAYED
}

model Milestone {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title         String          @db.VarChar(180)
  description   String?         @db.VarChar(4000)
  responsibleId String?         @map("responsible_id") @db.Uuid
  responsible   User?           @relation("MilestoneResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  startDate     DateTime        @map("start_date") @db.Date
  dueDate       DateTime        @map("due_date") @db.Date
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)
  status        MilestoneStatus @default(NOT_STARTED)
  priority      Priority        @default(MEDIUM)
  displayOrder  Int             @default(0) @map("display_order")
  createdById   String          @map("created_by_id") @db.Uuid
  createdBy     User            @relation("MilestoneCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(3)
  tasks         Task[]

  @@unique([id, projectId])
  @@index([projectId, archivedAt, displayOrder])
  @@index([responsibleId, dueDate])
  @@index([createdById])
  @@map("milestones")
}

enum TransactionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED_FOR_REVISION
  CANCELLED
}

enum WorkflowStatus {
  ACTIVE
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum ApprovalStepState {
  WAITING
  PENDING
  DECIDED
  CANCELLED
}

enum ApprovalOutcome {
  APPROVED
  REJECTED
  RETURNED
}

model TransactionType {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique @db.VarChar(100)
  active       Boolean              @default(true)
  transactions ProjectTransaction[]

  @@map("transaction_types")
}

model ProjectTransaction {
  expense         Expense?
  id              String             @id @default(uuid()) @db.Uuid
  reference       String             @unique @db.VarChar(50)
  projectId       String             @map("project_id") @db.Uuid
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  typeId          String             @map("type_id") @db.Uuid
  type            TransactionType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  title           String             @db.VarChar(180)
  description     String?            @db.VarChar(4000)
  notes           String?            @db.VarChar(4000)
  requestedAmount Decimal            @map("requested_amount") @db.Decimal(16, 2)
  currency        String             @default("PHP") @db.VarChar(3)
  requesterId     String             @map("requester_id") @db.Uuid
  requester       User               @relation("TransactionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  departmentId    String?            @map("department_id") @db.Uuid
  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  transactionDate DateTime           @map("transaction_date") @db.Date
  status          TransactionStatus  @default(DRAFT)
  submittedAt     DateTime?          @map("submitted_at") @db.Timestamptz(3)
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(3)
  rejectedAt      DateTime?          @map("rejected_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflows       ApprovalWorkflow[]

  @@index([projectId, status, transactionDate])
  @@index([requesterId, createdAt])
  @@index([departmentId])
  @@index([typeId])
  @@map("project_transactions")
}

model ApprovalPolicy {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @unique @map("project_id") @db.Uuid
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  primaryReviewerId   String?  @map("primary_reviewer_id") @db.Uuid
  primaryReviewer     User?    @relation("PolicyPrimary", fields: [primaryReviewerId], references: [id], onDelete: Restrict)
  finalReviewerId     String?  @map("final_reviewer_id") @db.Uuid
  finalReviewer       User?    @relation("PolicyFinal", fields: [finalReviewerId], references: [id], onDelete: Restrict)
  requireSecondReview Boolean  @default(true) @map("require_second_review")
  updatedById         String   @map("updated_by_id") @db.Uuid
  updatedBy           User     @relation("PolicyEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([primaryReviewerId])
  @@index([finalReviewerId])
  @@index([updatedById])
  @@map("approval_policies")
}

model ApprovalWorkflow {
  id              String             @id @default(uuid()) @db.Uuid
  transactionId   String             @map("transaction_id") @db.Uuid
  transaction     ProjectTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  attempt         Int
  currentStage    Int                @default(1) @map("current_stage")
  status          WorkflowStatus     @default(ACTIVE)
  requestSnapshot Json               @map("request_snapshot")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  steps           ApprovalStep[]

  @@unique([transactionId, attempt])
  @@index([status])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                 String            @id @default(uuid()) @db.Uuid
  workflowId         String            @map("workflow_id") @db.Uuid
  workflow           ApprovalWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  sequence           Int
  assignedApproverId String            @map("assigned_approver_id") @db.Uuid
  assignedApprover   User              @relation("StepApprover", fields: [assignedApproverId], references: [id], onDelete: Restrict)
  state              ApprovalStepState @default(WAITING)
  decision           ApprovalDecision?

  @@unique([workflowId, sequence])
  @@unique([workflowId, assignedApproverId])
  @@index([assignedApproverId, state])
  @@map("approval_steps")
}

model ApprovalDecision {
  id         String          @id @default(uuid()) @db.Uuid
  stepId     String          @unique @map("step_id") @db.Uuid
  step       ApprovalStep    @relation(fields: [stepId], references: [id], onDelete: Restrict)
  approverId String          @map("approver_id") @db.Uuid
  approver   User            @relation("DecisionApprover", fields: [approverId], references: [id], onDelete: Restrict)
  outcome    ApprovalOutcome
  comment    String?         @db.VarChar(2000)
  timestamp  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([approverId, timestamp])
  @@map("approval_decisions")
}

enum ExpenseKind {
  POSTING
  REVERSAL
}

model Expense {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transactionId  String?             @unique @map("transaction_id") @db.Uuid
  transaction    ProjectTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  category       String              @db.VarChar(100)
  description    String              @db.VarChar(4000)
  amount         Decimal             @db.Decimal(16, 2)
  expenseDate    DateTime            @map("expense_date") @db.Date
  kind           ExpenseKind         @default(POSTING)
  recordedById   String              @map("recorded_by_id") @db.Uuid
  recordedBy     User                @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  reversalOfId   String?             @unique @map("reversal_of_id") @db.Uuid
  reversalOf     Expense?            @relation("ExpenseReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     Expense?            @relation("ExpenseReversal")
  reversalReason String?             @map("reversal_reason") @db.VarChar(2000)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([projectId, expenseDate])
  @@index([category, expenseDate])
  @@index([recordedById])
  @@map("expenses")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
  metadata   Json?

  @@index([actorId, timestamp])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// connect-pg-simple owns row serialization. Identity stays inside the session payload;
// active user/role/status is resolved from users on every protected request.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("sessions")
}
