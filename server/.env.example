NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://viotechpm:REPLACE_ME@localhost:55432/viotechpm?schema=public
# Optional migration-owner/direct connection for future Neon setup:
# DIRECT_DATABASE_URL=postgresql://migration_owner:REPLACE_ME@host/viotechpm?sslmode=verify-full
TEST_DATABASE_URL=postgresql://viotechpm:REPLACE_ME@localhost:55432/viotechpm_test?schema=public
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_NAME=Viotech Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@viotech.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
# Set to 1 only behind one trusted reverse proxy in production.
TRUST_PROXY=0
